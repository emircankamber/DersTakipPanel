# Supabase → Project Settings → API (Data API) sayfasından alın.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# "anon" / "publishable" anahtar (tarayıcıya açılması güvenlidir; RLS korur).
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# İsteğe bağlı: e-posta doğrulama bağlantılarının döneceği adres.
# Boş bırakılırsa isteğin geldiği alan adı kullanılır.
# Örn. üretimde: https://ders-takip.vercel.app
NEXT_PUBLIC_SITE_URL=

# --- Ödev hatırlatma e-postaları (yalnızca sunucuda; NEXT_PUBLIC_ öneki YOK) ---
# Supabase → Project Settings → API Keys → Secret key (sb_secret_...) ya da legacy service_role.
# RLS'i atlar: asla tarayıcıya/GitHub'a koymayın, yalnızca Vercel ortam değişkeni olarak girin.
SUPABASE_SERVICE_ROLE_KEY=
# resend.com → API Keys
RESEND_API_KEY=
# Gönderen. Kendi alan adınızı Resend'de doğrulamadıysanız varsayılan kalsın:
# onboarding@resend.dev yalnızca Resend hesabınızın e-posta adresine gönderebilir.
REMINDER_FROM_EMAIL=Dönem <onboarding@resend.dev>
# Vercel Cron isteğini doğrulamak için rastgele uzun bir değer (ör. openssl rand -hex 32).
CRON_SECRET=
